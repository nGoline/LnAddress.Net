<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.1.0</Version>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <FileVersion>0.1.0</FileVersion>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.36.2" />
        <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
        <PackageReference Include="Grpc.Tools" Version="2.84.0">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Grpc\lightning.proto" GrpcServices="Client" />
        <Protobuf Include="Grpc\cln\node.proto" ProtoRoot="Grpc\cln" GrpcServices="Client" />
        <Protobuf Include="Grpc\cln\primitives.proto" ProtoRoot="Grpc\cln" GrpcServices="None" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Models\Requests\" />
    </ItemGroup>

</Project>
